# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# DO NOT PLACE REAL PRODUCTION OR PERSONAL SECRETS IN THIS FILE.
# To configure your machine:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in at least ONE AI provider key below (e.g. GEMINI_API_KEY).
#   3. Restart your dev server: npm run dev
#   4. Validate your configuration: npm run ai:check
# ==============================================================================

# Application Metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Nexora"
NEXT_PUBLIC_APP_VERSION="0.4.0"

# ------------------------------------------------------------------------------
# AI MODEL PROVIDERS (Server-Side Only - At least one required)
# ------------------------------------------------------------------------------
# Google Gemini (Recommended for local dev - Free tier available)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...your-gemini-key
# Alternative alias supported: GOOGLE_API_KEY=AIzaSy...

# OpenAI (Requires active billing credits)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...your-openai-key

# Anthropic (Optional - requires Anthropic credits)
# Get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...your-anthropic-key

# ------------------------------------------------------------------------------
# CREATIVE STUDIO: IMAGE & MUSIC GENERATION (Server-Side Only - Optional)
# ------------------------------------------------------------------------------
# Image Generation Providers:
# OpenAI DALL-E 3 (uses OPENAI_API_KEY above)
# Replicate (FLUX.1-schnell / SDXL)
REPLICATE_API_TOKEN=r8_...your-replicate-token
# Hugging Face Inference API (FLUX.1-schnell)
HF_TOKEN=hf_...your-huggingface-token
# Image provider override: auto (default) | openai | replicate | huggingface | pollinations | none
IMAGE_PROVIDER=auto

# Music Generation Providers:
# Suno API / Udio / Replicate / ElevenLabs
SUNO_API_KEY=suno_...your-suno-key
UDIO_API_KEY=udio_...your-udio-key
ELEVENLABS_API_KEY=eleven_...your-elevenlabs-key
# Music provider override: auto | suno | udio | replicate | synthesizer | none
MUSIC_PROVIDER=auto

# ------------------------------------------------------------------------------
# DATABASE & AUTH (Supabase)
# ------------------------------------------------------------------------------
# Obtain from your Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key-server-only

# ------------------------------------------------------------------------------
# WEB SEARCH & LIVE DATA (Optional)
# ------------------------------------------------------------------------------
WEB_SEARCH_API_KEY=tvly-...your-search-api-key
WEB_SEARCH_PROVIDER=tavily

# ------------------------------------------------------------------------------
# BILLING & PAYMENTS (Razorpay - Optional for local dev)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...your-test-key-id
RAZORPAY_KEY_SECRET=your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ------------------------------------------------------------------------------
# OBSERVABILITY & TELEMETRY (Optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
