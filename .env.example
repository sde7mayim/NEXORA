# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION (.env.example)
# Do NOT place live credentials or secrets in this file.
# Copy this file to .env.local for local development.
# ==============================================================================

# Public Application Metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Nexora"
NEXT_PUBLIC_APP_VERSION="0.1.0-dev"

# Supabase Configuration
# Obtain from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key-server-only

# AI Providers (Server-Only Credentials)
OPENAI_API_KEY=sk-...your-openai-key
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key
GEMINI_API_KEY=AQ...your-gemini-api-key

# Web Research Provider (Server-Only)
# Options: Tavily, SerpAPI, etc.
WEB_SEARCH_API_KEY=tvly-...your-search-api-key
WEB_SEARCH_PROVIDER=tavily

# Billing & Payments - Razorpay (Server-Only & Public Key)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...your-test-key-id
RAZORPAY_KEY_SECRET=...your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=...your-webhook-secret

# Telemetry / Error Tracking (Optional)
SENTRY_DSN=
